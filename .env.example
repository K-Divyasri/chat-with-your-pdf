# Copy this file to ".env" and fill in a key ONLY if you want real-LLM answers.
# The whole project runs fine offline with no key at all.
#
# Get a free Gemini key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-key-here

# Which model the --real flag uses (LiteLLM model string). Optional.
PDFCHAT_MODEL=gemini/gemini-1.5-flash
